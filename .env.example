# Salin file ini jadi .env.local (untuk testing lokal dengan `vercel dev`)
# JANGAN commit .env.local ke git — sudah masuk .gitignore

INVEZGO_API_KEY=isi_api_key_invezgo_anda_disini

# Dari Supabase Dashboard: Project Settings > API
# PENTING: pakai service_role key, BUKAN anon/public key — service_role diperlukan
# untuk menulis (insert) dari server tanpa terhalang Row Level Security.
# JANGAN PERNAH pakai key ini di kode frontend/browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key_supabase_anda_disini

# OPSIONAL — dari https://console.groq.com/keys (gratis, tanpa kartu kredit).
# Kalau kosong, ekstraksi kode saham tetap jalan hanya dengan regex + blocklist
# (kurang akurat untuk konteks kalimat kompleks, tapi tidak akan error).
GROQ_API_KEY=isi_groq_api_key_anda_disini
